<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_list_vn_care" model="ir.ui.view">
        <field name="name">res.users.view.list.vn.care</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Customer Care Team" create="0" delete="0" edit="0" export_xlsx="0"
                decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="name"/>
                <field name="login" string="Email"/>
                <field name="vn_care_level"/>
                <field name="vn_care_open_count"/>
                <field name="login_date" string="Last Login"/>
                <button name="action_vn_care_change_level" string="Change Level" type="object" invisible="not active"/>
                <button name="action_vn_care_deactivate" string="Deactivate" type="object" invisible="not active"
                    confirm="This person will no longer be able to log in. Continue?"/>
                <button name="action_vn_care_reactivate" string="Reactivate" type="object" invisible="active"/>
            </list>
        </field>
    </record>

    <record id="res_users_view_search_vn_care" model="ir.ui.view">
        <field name="name">res.users.view.search.vn.care</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Search Team">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('login', 'ilike', self)]"/>
                <filter name="inactive" string="Deactivated" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="res_users_action_vn_care_team" model="ir.actions.act_window">
        <field name="name">Customer Care Team</field>
        <field name="res_model">res.users</field>
        <field name="path">care-staff</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="res_users_view_list_vn_care"/>
        <field name="search_view_id" ref="res_users_view_search_vn_care"/>
        <field name="domain" eval="[('all_group_ids', 'in', [ref('vn_care.vn_care_group_agent')]), ('share', '=', False), ('id', '!=', ref('base.user_root'))]"/>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
