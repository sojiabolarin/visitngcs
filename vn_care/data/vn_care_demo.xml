        <field name="user_id" ref="base.user_admin"/>
        <field name="state">resolved</field>
        <field name="outcome">converted</field>
    </record>
    <record id="vn_care_enquiry_demo_5" model="vn.care.enquiry" context="{'vn_care_import': True}">
