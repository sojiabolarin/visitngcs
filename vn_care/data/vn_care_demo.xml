        <field name="submission_id">demo-0001</field>
        <field name="customer_name">Ada Obi</field>
        <field name="email">ada.obi@example.com</field>
        <field name="phone">+234 800 000 0001</field>
        <field name="category_id" ref="vn_care_category_hotels"/>
