        <field name="user_id" ref="base.user_admin"/>
        <field name="state">in_progress</field>
    </record>
    <record id="vn_care_enquiry_demo_3" model="vn.care.enquiry" context="{'vn_care_import': True}">
        <field name="submission_id">demo-0003</field>
        <field name="customer_name">Ngozi Bello</field>
        <field name="email">ngozi.bello@example.com</field>
