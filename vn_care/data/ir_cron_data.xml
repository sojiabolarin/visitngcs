<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_vn_care_push_sync" model="ir.cron">
        <field name="name">Customer Care: send status changes to the website</field>
        <field name="model_id" ref="model_vn_care_enquiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_push_sync()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_vn_care_retry_sync" model="ir.cron">
        <field name="name">Customer Care: retry failed website updates</field>
        <field name="model_id" ref="model_vn_care_enquiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_sync()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_vn_care_reconcile" model="ir.cron">
        <field name="name">Customer Care: nightly reconciliation with the website</field>
        <field name="model_id" ref="model_vn_care_enquiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_vn_care_auto_close" model="ir.cron">
        <field name="name">Customer Care: close resolved enquiries</field>
        <field name="model_id" ref="model_vn_care_enquiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_close()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
